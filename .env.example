# Copy to .env only if you need to change something; everything has a working default.
# Nothing here is secret.

# Port to listen on. Render sets this for you.
PORT=3000

# "production" on Render: Mimic then refuses socket connections from other sites (localhost is allowed in development).
NODE_ENV=production

# Extra origins allowed to open Mimic's socket, comma-separated. Same-origin always works, so leave empty
# unless the page is served from a different domain than the server.
MIMIC_ALLOWED_ORIGINS=

# Use X-Forwarded-For for per-IP rate limits. Automatic on Render (it sets RENDER=true).
TRUST_PROXY=0

# Set to 0 to silence the JSON server logs of a game.
MIMIC_LOG=1
JUTPATTI_LOG=1
FLASH_LOG=1
DHUMBAL_LOG=1
